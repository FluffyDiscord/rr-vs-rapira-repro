{
    "name": "fluffydiscord/rr-vs-rapira-repro",
    "description": "Minimal Symfony app served by both RoadRunner and Rapira for a like-for-like latency/throughput benchmark.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "fluffydiscord/rapira-symfony-bundle": "dev-master",
        "fluffydiscord/roadrunner-symfony-bundle": "^7.1.2",
        "rapira/contract": "dev-master",
        "symfony/console": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.5.10"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/FluffyDiscord/rapira-symfony-bundle"
        }
    ]
}
