# Caddy front-end for app-rapira, the modern-Go-proxy counterpart to docker/nginx/rapira.conf.
# Same HTTP upstream nginx-rapira proxies to, so only the proxy differs. No tuning: Caddy's
# reverse_proxy pools upstream connections (HTTP/1.1 keepalive) by default, which is exactly the
# knob nginx's bare proxy_pass was missing. X-Forwarded-For/Host are set automatically.
{
	admin off
	auto_https off
}

:80 {
	reverse_proxy app-rapira:8000 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443
	}
}
